  font-size: 16px;
  background: white;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.char-count.data-v-3c212b86 {
  text-align: right;
  color: #999;
  font-size: 14px;
  margin-bottom: 15px;
}
.translate-btn.data-v-3c212b86 {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 20px;
  box-shadow: 0 4px 12px rgba(0,122,255,0.3);
  transition: all 0.3s;
}
.translate-btn.data-v-3c212b86:disabled {
  background: #ccc;
  opacity: 0.6;
