}
.language-selector text.data-v-3c212b86 {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}
.language-selector button.data-v-3c212b86 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
