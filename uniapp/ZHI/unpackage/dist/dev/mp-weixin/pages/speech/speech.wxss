
.container.data-v-3c212b86 {
  padding: 20px;
  max-width: 100%;
  box-sizing: border-box;
  background-color: #f8f9fa;
  min-height: 100vh;
}
.language-selector.data-v-3c212b86 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding: 15px;
