<view class="container"><text class="title">小星单词</text><view class="login-card"><input class="input" placeholder="请输入用户名" placeholder-style="color:#999" data-event-opts="{{[['input',[['__set_model',['','username','$event',[]]]]]]}}" value="{{username}}" bindinput="__e"/><input class="input" type="{{inputType}}" password="true" placeholder="请输入密码" placeholder-style="color:#999" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindinput="__e"/><view class="remember-row"><checkbox bindinput="__e" color="#007AFF" value="{{rememberPassword}}" data-event-opts="{{[['input',[['__set_model',['','rememberPassword','$event',[]]]]]]}}"></checkbox><text>记住密码</text></view><button data-event-opts="{{[['tap',[['login',['$event']]]]]}}" class="login-btn" bindtap="__e">登录/注册</button></view></view>