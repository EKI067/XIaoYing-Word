<view class="container"><view class="avatar-box"><image class="avatar" src="{{user.avatar_path||defaultAvatar}}"></image><button data-event-opts="{{[['tap',[['chooseAvatar',['$event']]]]]}}" class="upload-btn" bindtap="__e">上传头像</button></view><view class="field"><text class="label">用户名：</text><input data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['user']]]]]}}" class="username-input" value="{{user.username}}" bindinput="__e"/></view><button data-event-opts="{{[['tap',[['saveUser',['$event']]]]]}}" class="save-btn" bindtap="__e">保存信息</button><view class="btn-row"><button data-event-opts="{{[['tap',[['goSpeech',['$event']]]]]}}" class="nav-btn" bindtap="__e">🎙️ 中英互译</button><button data-event-opts="{{[['tap',[['goMemo',['$event']]]]]}}" class="nav-btn" bindtap="__e">📝 备忘录</button></view></view>