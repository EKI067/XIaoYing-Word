<view class="container data-v-d7d86d74"><view class="header data-v-d7d86d74"><view class="title-wrap data-v-d7d86d74"><text class="title data-v-d7d86d74">英语好句笔记本</text><text class="subtitle data-v-d7d86d74">Daily English Notes</text></view><button data-event-opts="{{[['tap',[['goSearch',['$event']]]]]}}" class="btn-search-page data-v-d7d86d74" bindtap="__e">🔍 搜索</button></view><view class="card input-card data-v-d7d86d74"><view class="card-header data-v-d7d86d74"><text class="card-title data-v-d7d86d74">输入英语句子</text><text class="tip-text data-v-d7d86d74">或使用下方推荐</text></view><view class="category-row data-v-d7d86d74"><picker range="{{categories}}" data-event-opts="{{[['change',[['onCategoryChange',['$event']]]]]}}" bindchange="__e" class="data-v-d7d86d74"><view class="picker data-v-d7d86d74">{{''+(selectedCategory||'默认：日常')+''}}</view></picker><input class="category-input data-v-d7d86d74" placeholder="自定义分类（可选）" data-event-opts="{{[['input',[['__set_model',['','customCategory','$event',[]]]]]]}}" value="{{customCategory}}" bindinput="__e"/></view><textarea class="input data-v-d7d86d74" placeholder="请输入英语内容..." data-event-opts="{{[['input',[['__set_model',['','text','$event',[]]]]]]}}" value="{{text}}" bindinput="__e"></textarea></view><view class="card sentence-card data-v-d7d86d74"><view class="card-header data-v-d7d86d74"><text class="card-title data-v-d7d86d74">✨ 今日好句</text><button data-event-opts="{{[['tap',[['randomSentence',['$event']]]]]}}" class="random-btn data-v-d7d86d74" bindtap="__e">🎲 换一句</button></view><block wx:if="{{currentSentence}}"><view data-event-opts="{{[['tap',[['useSentence',['$0'],['currentSentence.en']]]]]}}" class="sentence-item data-v-d7d86d74" bindtap="__e"><text class="en data-v-d7d86d74">{{currentSentence.en}}</text><text class="zh data-v-d7d86d74">{{currentSentence.zh}}</text><text class="hint data-v-d7d86d74">点击即可使用</text></view></block></view><button class="btn analyze-btn data-v-d7d86d74" disabled="{{!$root.g0}}" data-event-opts="{{[['tap',[['analyzeText',['$event']]]]]}}" bindtap="__e">📝 分析并保存</button><block wx:if="{{result}}"><view class="card result-card data-v-d7d86d74" animation="{{resultAnimation}}"><view class="card-header data-v-d7d86d74"><text class="card-title data-v-d7d86d74">分析结果</text><block wx:if="{{result.isImportant}}"><text class="badge data-v-d7d86d74">⭐ 重点</text></block></view><view class="result-content data-v-d7d86d74"><view class="row data-v-d7d86d74"><text class="label data-v-d7d86d74">分类：</text><text class="value data-v-d7d86d74">{{result.category}}</text></view><view class="row data-v-d7d86d74"><text class="label data-v-d7d86d74">标签：</text><view class="tag-list data-v-d7d86d74"><block wx:for="{{result.tags}}" wx:for-item="tag" wx:for-index="i" wx:key="i"><text class="tag data-v-d7d86d74">{{'#'+tag+''}}</text></block></view></view><block wx:if="{{result.example}}"><view class="row data-v-d7d86d74"><text class="label data-v-d7d86d74">示例：</text><text class="value example data-v-d7d86d74">{{result.example}}</text></view></block></view><view class="action-row data-v-d7d86d74"><button data-event-opts="{{[['tap',[['toggleImportant',['$0'],['result']]]]]}}" class="btn-mark data-v-d7d86d74" bindtap="__e">{{''+(result.isImportant?'取消重点':'标记重点')+''}}</button></view></view></block><view class="card recent-card data-v-d7d86d74"><view class="card-header data-v-d7d86d74"><text class="card-title data-v-d7d86d74">📌 最近记录</text></view><block wx:if="{{$root.g1}}"><view class="recent-list data-v-d7d86d74"><block wx:for="{{recentRecords}}" wx:for-item="record" wx:for-index="i" wx:key="i"><view data-event-opts="{{[['tap',[['useSentence',['$0'],[[['recentRecords','',i,'text']]]]]]]}}" class="recent-item data-v-d7d86d74" bindtap="__e"><text class="recent-text data-v-d7d86d74">{{record.text}}</text><text class="recent-category data-v-d7d86d74">{{"["+record.category+"]"}}</text><button data-event-opts="{{[['tap',[['toggleImportant',['$0'],[[['recentRecords','',i]]]]]]]}}" class="btn-mark-small data-v-d7d86d74" catchtap="__e">{{''+(record.isImportant?'⭐':'☆')+''}}</button></view></block></view></block><block wx:else><view class="empty-tip data-v-d7d86d74">暂无最近记录</view></block></view></view>